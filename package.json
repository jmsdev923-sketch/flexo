{
  "name": "flex-analytics",
  "version": "1.0.0",
  "description": "Enterprise-grade web pivot table and data analytics engine inspired by Flexmonster",
  "main": "server/index.js",
  "scripts": {
    "server": "node --watch server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
